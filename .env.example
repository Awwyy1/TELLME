# Required
ANTHROPIC_API_KEY=sk-ant-...

# Shared rate limits across all serverless instances (recommended).
# Vercel → Storage → Upstash Redis creates these automatically
# (KV_REST_API_URL / KV_REST_API_TOKEN are also accepted).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile invisible bot check (recommended).
# Both must be set to enable it.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Limits (optional, defaults shown)
PER_MINUTE_LIMIT=5
PER_IP_DAILY_LIMIT=60
DAILY_MESSAGE_LIMIT=3000

# Salt for hashing visitor IPs (optional, any random string)
IP_HASH_SALT=
